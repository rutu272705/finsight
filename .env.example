# Copy this file to .env and fill in values. Never commit .env.

# --- News ---------------------------------------------------------------
# Free key from https://newsapi.org/register (free tier: 100 requests/day,
# articles up to ~1 month old). Leave blank to use the key-free providers.
NEWSAPI_KEY=
# Comma-separated, tried in order: newsapi, googlenews, yahoo
NEWS_PROVIDERS=newsapi,googlenews,yahoo

# --- NLP backends ---------------------------------------------------------
# finbert  = ProsusAI/finbert via transformers (pip install -r requirements-optional.txt)
# lexicon  = built-in financial lexicon (no model download; use as a lightweight alternative)
SENTIMENT_BACKEND=finbert
# extractive = built-in, no downloads | transformers = abstractive (optional)
SUMMARIZER_BACKEND=extractive
# auto = use spaCy if installed with en_core_web_sm, otherwise regex rules
ENTITY_BACKEND=auto

# --- Machine learning -------------------------------------------------------
FORECAST_HORIZON=5          # trading sessions ahead
TREND_THRESHOLD=0.01        # +/-1% five-session return separates Up/Down from Stable
TRAIN_HISTORY_PERIOD=5y
MODEL_MAX_AGE_DAYS=7        # retrain on demand when a saved model is older

# --- App ---------------------------------------------------------------------
FLASK_ENV=development
PORT=5000
DATABASE_PATH=backend/finsight.db
CORS_ORIGINS=http://localhost:5173
CACHE_TTL_SECONDS=300
HTTP_TIMEOUT_SECONDS=10

# Set to true ONLY for offline demos. Replaces live market/news data with
# clearly labelled synthetic data. The UI shows a banner whenever this is on.
DEMO_MODE=false
